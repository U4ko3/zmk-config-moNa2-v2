#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/* ZMK 側で 10 が定義済みなので警告回避のため一旦 undef */
#undef ZMK_POINTING_DEFAULT_SCRL_VAL
#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

// OS設定を日本語キーボードのまま使用するための変換定義

#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角

&mt {
  flavor = "balanced";
  quick-tap-ms = <0>;
};

&lt {
  quick-tap-ms = <200>;
  flavor = "balanced";
};

&msc {
  delay-ms = <0>;
  time-to-max-speed-ms = <0>;
  acceleration-exponent = <0>;
};

/ {
  combos {
    compatible = "zmk,combos";

    layer4_ESC {
      bindings = <&lt 4 ESC>;
      key-positions = <39 38>;
    };
      
    tab {
      bindings = <&kp TAB>;
      key-positions = <11 12>;
    };

    shift_tab {
      bindings = <&kp LS(TAB)>;
      key-positions = <12 13>;
    };

    double_quotation {
      bindings = <&kp DOUBLE_QUOTES>;
      key-positions = <20 21>;
    };

    eq {
      bindings = <&kp EQUAL>;
      key-positions = <24 25>;
    };
  };

  macros {
    to_layer_0: to_layer_0 {
    compatible = "zmk,behavior-macro-one-param";
    #binding-cells = <1>;
    bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
    label = "TO_LAYER_0";
  };

  BT0: BT0 {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    bindings =
    <&tog_off 0 &tog_off 1>,
    <&macro_wait_time 200>,
    <&bt BT_SEL 0>,
    <&macro_wait_time 500>,
    <&tog_on 0>;
    
    label = "BT0";
    };

  BT1: BT1 {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    bindings =
      <&tog_off 0 &tog_off 1>,
      <&macro_wait_time 200>,
      <&bt BT_SEL 1>,
      <&macro_wait_time 500>,
      <&tog_on 1>;
  
    label = "BT1";
  };

  screenshot: screenshot {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    bindings =
      <&macro_press>,
      <&kp LEFT_GUI &kp RSHIFT>,
      <&macro_wait_time 20>,
      <&macro_tap>,
      <&kp S>,
      <&macro_release>,
      <&kp LEFT_GUI &kp RSHIFT>;
  
    label = "SCREENSHOT";
  };

  henkan: henkan {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    bindings =
      <&macro_press>,
      <&kp LEFT_ALT>,
      <&macro_wait_time 20>,
      <&macro_tap>,
      <&kp GRAVE>,
      <&macro_release>,
      <&kp LEFT_ALT>;
  
    label = "HENKAN";
    };
  };

  behaviors {
    lt_to_layer_0: lt_to_layer_0 {
      compatible = "zmk,behavior-hold-tap";
      label = "LAYER_TAP_TO_0";
      bindings = <&mo>, <&to_layer_0>;
  
      #binding-cells = <2>;
      tapping-term-ms = <200>;
    };

    tp_repeat_mo1: tp_repeat_mo1 {
      compatible = "zmk,behavior-hold-tap";
      label = "TP_REPEAT_MO1";
      bindings = <&mo>, <&key_repeat>;
    
      #binding-cells = <2>;
      tapping-term-ms = <200>;
    };

    // エンコーダ用 runtime-configurable sensor rotate
    // デフォルトはスクロール (cw=SCRL_DOWN, ccw=SCRL_UP)
    // DYA Studio Web UI から レイヤーごとに cw/ccw の binding を
    // kp C_VOL_UP/DN や kp LEFT/RIGHT などへ動的変更可能
    rsr_default: rsr_default {
      compatible = "zmk,behavior-runtime-sensor-rotate";
      #sensor-binding-cells = <0>;
      tap-ms = <16>;
      cw-binding = <&msc SCRL_DOWN>;
      ccw-binding = <&msc SCRL_UP>;
    };

    tog_on: toggle_layer_on_only {
      compatible = "zmk,behavior-toggle-layer";
      #binding-cells = <1>;
      display-name = "Toggle Layer On";
      toggle-mode = "on";
    };

    tog_off: toggle_layer_off_only {
      compatible = "zmk,behavior-toggle-layer";
      #binding-cells = <1>;
      display-name = "Toggle Layer Off";
      toggle-mode = "off";
    };

    zfold: zfold {
      compatible = "zmk,behavior-hold-tap";
      label = "ZFOLD";
      bindings = <&kp>, <&kp>;
    
      #binding-cells = <2>;
      tapping-term-ms = <300>;
      flavor = "hold-preferred";
      quick-tap-ms = <150>;
      hold-while-undecided;
    };

    zfoldZ: zfoldZ {
      compatible = "zmk,behavior-tap-dance";
      label = "ZFOLDZ";
      #binding-cells = <0>;
      bindings = <&zfold LEFT_SHIFT Z>, <&kp LS(Z)>;
    };
  };

  keymap {
    compatible = "zmk,keymap";

    win_layer {
      display-name = "WIN";
      bindings = <
&kp ESCAPE &kp EXCLAMATION      &kp AT_SIGN           &kp HASH         &kp DOLLAR                              &kp EQUAL     &kp NUMBER_7 &kp NUMBER_8 &kp NUMBER_9 &kp ASTERISK
&kp TAB    &kp PERCENT          &kp CARET             &kp AMPERSAND    &kp ASTERISK                &kp PERCENT &kp NUMBER_0  &kp NUMBER_4 &kp NUMBER_5 &kp NUMBER_6 &kp MINUS
&kp PIPE   &kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp LEFT_BRACKET &kp RIGHT_BRACKET &trans    &kp PLUS    &kp DOT       &kp NUMBER_1 &kp NUMBER_2 &kp NUMBER_3 &kp SLASH
&kp LCTRL  &kp LEFT_GUI         &kp LEFT_ALT          &trans           &trans            &trans    &kp ENTER   &kp BACKSPACE                                        &kp RIGHT_SHIFT
      >;

      sensor-bindings =
        <&rsr_default>,
        <&inc_dec_kp C_VOL_DN C_VOL_UP>;
    };

    function_win {
      display-name = "FN_W";
      bindings = <
&kp ESCAPE      &kp JP_HANZEN  &kp PRINTSCREEN  &kp SCROLLLOCK  &kp PAUSE_BREAK                       &kp F1        &kp F2        &kp F3      &kp F4       &kp F5
&kp TAB         &trans         &kp INSERT       &kp HOME        &kp PAGE_UP      &trans      &kp F13  &kp F6        &kp F7        &kp F8      &kp F9       &kp F10
&kp CAPS        &trans         &kp DELETE       &kp END         &kp PAGE_DOWN    &trans      &trans   &kp JP_CARET  &kp JP_TILDE  &kp JP_YEN  &kp JP_PIPE  &kp F11
&kp LEFT_SHIFT  &trans         &trans           &trans          &trans           &trans      &kp DEL  &trans                                               &kp F12
      >;
    };

    num_win {
      display-name = "NUM_W";
      bindings = <
&kp MINUS     &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp PLUS                                                      &trans            &kp CARET        &kp JP_QUOTE     &kp JP_LPAREN  &kp JP_RPAREN
&kp SLASH     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp ASTERISK  &kp LC(LA(KP_NUMBER_0))      &kp JP_UNDERSCORE  &kp EXCLAMATION   &kp AT_SIGN      &kp HASH         &kp DOLLAR     &kp PERCENT
&kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD    &kp EQUAL                    &kp JP_AT          &kp JP_BACKQUOTE  &kp JP_LBRACKET  &kp JP_RBRACKET  &kp JP_LBRACE  &kp JP_RBRACE
&trans        &trans        &trans        &trans        &trans        &trans                       &trans             &trans                                                             &kp PIPE
      >;

      sensor-bindings = <&rsr_default>;
    };

    arrow_win{
      display-name = "ARROW_W";
      bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &kp PAGE_UP                        &trans          &kp LG(LC(LEFT_ARROW))  &kp LG(LC(RIGHT_ARROW))  &trans           &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END        &trans      &trans  &kp LEFT_ARROW  &kp DOWN_ARROW          &kp UP_ARROW             &kp RIGHT_ARROW  &trans
&kp LEFT_SHIFT  &kp LG(LC(LEFT_ARROW))  &trans          &kp LG(LC(RIGHT_ARROW))  &kp PAGE_DOWN  &trans      &trans  &trans          &kp LC(LS(PG_UP))       &kp LC(LS(PG_DN))        &trans           &trans
&trans          &trans                  &trans          &trans                   &trans         &trans      &trans  &trans                                                                            &trans
            >;

      sensor-bindings = <&rsr_default>;
    };

    mouse_win {
      display-name = "MOUSE_W";
      bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &msc SCRL_DOWN  &trans    &msc SCRL_UP  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1        &mkp MB3  &mkp MB2      &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB4        &trans    &mkp MB5      &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                          &trans
      >;

      sensor-bindings = <&rsr_default>;
    };

    scroll_win {
      display-name = "SCRL_W";
      bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
      >;

      sensor-bindings = <&rsr_default>;
    };

    ble_win {
      display-name = "BLE_W";
      bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &kp NUMBER_4  &trans        &trans        &trans  &trans      &trans       &studio_unlock &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
      >;
    };
  };
};
